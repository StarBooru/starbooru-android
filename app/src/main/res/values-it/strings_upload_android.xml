<?xml version="1.0" encoding="utf-8"?>
<!-- Upload text the web app doesn't have, or has in a form Android can't take. The rest is in strings_upload.xml. -->
<resources>
    <string name="upload_photos">Foto e video</string>
    <string name="upload_paste">Incolla</string>
    <string name="upload_clear_finished">Togli i completati</string>
